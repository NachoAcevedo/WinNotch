<UserControl x:Class="WinNotch.Views.InlineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/ToggleSwitchStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
                <ResourceDictionary Source="Components/SliderStyle.xaml"/>
                <ResourceDictionary Source="Components/SegmentedRadioStyle.xaml"/>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource InterfaceSection}">
                <Setter Property="Margin" Value="0,14,0,5"/>
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingLabelBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: back arrow + "Settings" title -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="OnBackClick"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        VerticalAlignment="Center" ToolTip="Back">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
                <TextBlock Text="Ajustes" Style="{StaticResource InterfaceTitle}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable settings in a compact two-column layout -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource RoundedScrollViewer}">
            <Border Style="{StaticResource InterfacePanel}" Padding="12,3"><StackPanel>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Iniciar con Windows" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="StartOnBootCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Hover mode -->
                <TextBlock Text="Al pasar el mouse" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,2"/>
                <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="{StaticResource InterfaceControlRadius}" Padding="2" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="HoverPeekRadio" Content="Vista previa y clic"
                                     Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnHoverModeChanged"/>
                        <RadioButton x:Name="LongHoverRadio" Content="Pausa del mouse"
                                     Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnHoverModeChanged"/>
                    </Grid>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="Apariencia" Style="{StaticResource SectionHeader}"/>

                <!-- Theme selector -->
                <TextBlock Text="Tema" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,2"/>
                <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="{StaticResource InterfaceControlRadius}" Padding="2" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ThemeDarkRadio" Content="Oscuro"
                                     Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="Claro"
                                     Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                    </Grid>
                </Border>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Seguir el tema de Windows" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="AdaptToWindowsThemeCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnAdaptThemeChanged" Unchecked="OnAdaptThemeChanged"/>
                </Grid>
                <TextBlock Text="Usa el tema, el acento y el contraste de Windows."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Mostrar sombra" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowShadowCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Notch mínimo siempre visible" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="AlwaysShowMinimumCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Visible sobre ventanas maximizadas y juegos. Pasá el mouse para abrirlo."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <!-- Cards: on/off for every card. Their options live in their own sections after Widgets. -->
                <TextBlock Text="Tarjetas" Style="{StaticResource SectionHeader}"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Media" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Calendario" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowCalendarCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Clima" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowWeatherCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Tareas" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowTasksCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="IA (Codex / Claude)" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowAgentCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Audio" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowAudioCardCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Baterías de dispositivos" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowBatteryCardCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Dock de archivos" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowFilesCheck" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Widgets -->
                <TextBlock Text="Widgets" Style="{StaticResource SectionHeader}"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Indicador de batería" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowBatteryCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Vista de la cámara" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowWebcamCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2" x:Name="WebcamFpsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FPS de la cámara" Style="{StaticResource SettingLabel}" Grid.Column="0"/>
                    <Slider x:Name="WebcamFpsSlider" Grid.Column="1"
                            Style="{StaticResource CompactSlider}"
                            Minimum="5" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" Margin="10,0,10,0"
                            ValueChanged="OnWebcamFpsChanged"/>
                    <Border Grid.Column="2" Background="{DynamicResource SegmentedBgBrush}"
                            CornerRadius="6" Padding="6,2" MinWidth="32">
                        <TextBlock x:Name="WebcamFpsLabel"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Media card options (disabled while the Media card is off) -->
                <StackPanel x:Name="MediaOptionsSection">
                    <TextBlock Text="Media" Style="{StaticResource SectionHeader}"/>

                    <Grid Height="32" Margin="0,2">
                        <TextBlock Text="Visualizador de audio" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="ShowVisualizerCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>
                </StackPanel>

                <!-- Calendar card options: plugins (BetterCalendar) add their rows to CalendarOptionsHost.
                     The section is hidden while empty and disabled while the Calendar card is off. -->
                <StackPanel x:Name="CalendarOptionsSection">
                    <TextBlock Text="Calendario" Style="{StaticResource SectionHeader}"/>
                    <StackPanel x:Name="CalendarOptionsHost"/>
                </StackPanel>

                <!-- Screens -->
                <TextBlock Text="Pantallas" Style="{StaticResource SectionHeader}"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Reservar espacio arriba" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ReserveSpaceCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Deja espacio para el notch sobre ventanas maximizadas. Las apps a pantalla completa pueden cubrirlo."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Notch en cada pantalla" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowOnAllScreensCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Muestra el notch en cada monitor conectado."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Sincronizar pantallas" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="SyncIslandsCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Abre y cierra el notch al mismo tiempo en todos los monitores."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <!-- Beta Features -->
                <TextBlock Text="Funciones beta" Style="{StaticResource SectionHeader}"/>

                <Grid Height="32" Margin="0,2">
                    <TextBlock Text="Tema Liquid Glass" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="LiquidGlassCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnLiquidGlassChanged" Unchecked="OnLiquidGlassChanged"/>
                </Grid>

                <!-- Plugins -->
                <TextBlock Text="Plugins" Style="{StaticResource SectionHeader}"/>

                <Button x:Name="ManagePluginsButton" Click="OnManagePluginsClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4">
                    <TextBlock Text="Administrar plugins"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>

                <!-- About -->
                <TextBlock Text="Acerca de" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFaintBrush}" FontSize="10" Text="WinNotch" Margin="0,0,0,2"/>
                <TextBlock Foreground="{DynamicResource TextFaintestBrush}" FontSize="9" Text="Inspired by boring.notch for macOS"
                           Margin="0,0,0,4"/>

                <!-- Update check -->
                <Grid Margin="0,0,0,8">
                    <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick"
                            HorizontalAlignment="Left" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <TextBlock x:Name="CheckUpdateText" Text="Check for updates"
                                   Foreground="{DynamicResource TextSubtleBrush}" FontSize="10"
                                   TextDecorations="Underline"/>
                    </Button>
                    <Button x:Name="UpdateButton" Click="OnUpdateClick"
                            Visibility="Collapsed" HorizontalAlignment="Left"
                            Cursor="Hand" Padding="6,3" Background="{DynamicResource SegmentedCheckedBgBrush}"
                            BorderThickness="0">
                        <TextBlock x:Name="UpdateButtonText" Text="Update available"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

            </StackPanel></Border>
        </ScrollViewer>
    </Grid>
</UserControl>

