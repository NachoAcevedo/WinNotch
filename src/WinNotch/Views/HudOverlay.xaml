<UserControl x:Class="WinNotch.Views.HudOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!-- Compact inline HUD shown in closed notch for volume/brightness changes -->
    <Grid>
    <Grid x:Name="LevelContent" HorizontalAlignment="Stretch" VerticalAlignment="Center"
          Margin="6,0,6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Icon -->
        <TextBlock x:Name="HudIcon"
                   Grid.Column="0"
                   FontFamily="Segoe Fluent Icons" Text="&#xE767;"
                   FontSize="14"
                   Foreground="{DynamicResource HudIconBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

        <!-- Slider track -->
        <Border Grid.Column="1"
                Height="6"
                CornerRadius="3"
                Background="{DynamicResource ProgressTrackBrush}"
                VerticalAlignment="Center"
                Cursor="Hand"
                MouseLeftButtonDown="OnSliderClick">
            <Border x:Name="SliderFill"
                    Height="6"
                    CornerRadius="3"
                    Background="{DynamicResource HudSliderFillBrush}"
                    HorizontalAlignment="Left"/>
        </Border>

        <!-- Percentage -->
        <TextBlock x:Name="HudPercent"
                   Grid.Column="2"
                   Text="50%"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="10"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   MinWidth="34"
                   TextAlignment="Right"/>
    </Grid>
    <Grid x:Name="FeedbackContent" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="{StaticResource InterfaceControlRadius}" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="FeedbackIcon" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="FeedbackTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="FeedbackDetail" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
    </Grid>
</UserControl>


