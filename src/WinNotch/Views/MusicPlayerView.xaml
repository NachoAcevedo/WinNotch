<UserControl x:Class="WinNotch.Views.MusicPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:WinNotch.Views.Components">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/MarqueeTextStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Geometry x:Key="TransportPlay">M 5,3 L 13,8 L 5,13 Z</Geometry>
            <Geometry x:Key="TransportPause">M 5,4 L 5,12 M 11,4 L 11,12</Geometry>
            <Geometry x:Key="TransportRepeat">M 3,7 A 2,2 0 0 1 5,5 H 13 M 11,3 L 13,5 L 11,7 M 13,9 A 2,2 0 0 1 11,11 H 3 M 5,9 L 3,11 L 5,13</Geometry>
            <Geometry x:Key="TransportRepeatOne">M 3,7 A 2,2 0 0 1 5,5 H 13 M 11,3 L 13,5 L 11,7 M 13,9 A 2,2 0 0 1 11,11 H 3 M 5,9 L 3,11 L 5,13 M 7,8 L 8,7 L 8,9</Geometry>
            <Style x:Key="TransportIcon" TargetType="Path">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
            </Style>

            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{StaticResource InterfaceControlRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TransportHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </Trigger>
                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Album art -->
        <Grid x:Name="AlbumArtGrid" Grid.Column="0" Margin="0,0,12,0">
            <Border Width="90" Height="90"
                    CornerRadius="{StaticResource InterfacePanelRadius}"
                    ClipToBounds="True">
                <Image x:Name="AlbumArtImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,90,90" RadiusX="12" RadiusY="12"/>
                    </Image.Clip>
                </Image>
            </Border>
        </Grid>

        <!-- Right side: info + controls -->
        <Grid x:Name="InfoControlsGrid" Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Song title (marquee) -->
            <comp:MarqueeText x:Name="TitleText"
                              Grid.Row="0"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Height="22"
                              Margin="0,0,0,1"/>

            <!-- Artist -->
            <comp:MarqueeText x:Name="ArtistText"
                              Grid.Row="1"
                              FontSize="11"
                              FontWeight="Normal"
                              Foreground="{DynamicResource TextTertiaryBrush}"
                              Height="17"
                              Margin="0,0,0,5"/>

            <!-- Progress bar -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ElapsedText"
                           Grid.Column="0"
                           Text="0:00"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <Border Grid.Column="1"
                        Height="4"
                        CornerRadius="2"
                        Background="{DynamicResource ProgressTrackBrush}"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnProgressBarClick">
                    <Border x:Name="ProgressFill"
                            Height="4"
                            CornerRadius="2"
                            Background="{DynamicResource ProgressFillBrush}"
                            HorizontalAlignment="Left"/>
                </Border>

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="0:00"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
            </Grid>

            <!-- Transport controls -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- Shuffle -->
                <Button x:Name="ShuffleButton"
                        Click="OnShuffleClick"
                        Style="{StaticResource TransportButton}"
                        Margin="0,0,8,0"
                        ToolTip="Shuffle">
                    <Path Style="{StaticResource TransportIcon}" Data="M 2,4 H 4 C 7,4 9,12 12,12 H 14 M 12,10 L 14,12 L 12,14 M 2,12 H 4 C 5,12 6,10 7,9 M 9,7 C 10,5 11,4 12,4 H 14 M 12,2 L 14,4 L 12,6"/>
                </Button>

                <!-- Previous -->
                <Button x:Name="PrevButton"
                        Click="OnPrevClick"
                        Style="{StaticResource TransportButton}"
                        Margin="0,0,6,0"
                        ToolTip="Previous">
                    <Path Style="{StaticResource TransportIcon}" Data="M 4,4 V 12 M 12,4 L 6,8 L 12,12 Z"/>
                </Button>

                <!-- Play/Pause -->
                <Button x:Name="PlayPauseButton"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource TransportButton}"
                        Width="32" Height="32"
                        Selector.IsSelected="True"
                        ToolTip="Play/Pause">
                    <Path x:Name="PlayPauseIcon" Style="{StaticResource TransportIcon}" Data="{StaticResource TransportPlay}"/>
                </Button>

                <!-- Next -->
                <Button x:Name="NextButton"
                        Click="OnNextClick"
                        Style="{StaticResource TransportButton}"
                        Margin="6,0,0,0"
                        ToolTip="Next">
                    <Path Style="{StaticResource TransportIcon}" Data="M 12,4 V 12 M 4,4 L 10,8 L 4,12 Z"/>
                </Button>

                <!-- Repeat -->
                <Button x:Name="RepeatButton"
                        Click="OnRepeatClick"
                        Style="{StaticResource TransportButton}"
                        Margin="8,0,0,0"
                        ToolTip="Repeat">
                    <Path x:Name="RepeatIcon" Style="{StaticResource TransportIcon}" Data="{StaticResource TransportRepeat}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- No media placeholder -->
        <TextBlock x:Name="NoMediaText"
                   Grid.ColumnSpan="2"
                   Text="No hay reproducción"
                   Foreground="{DynamicResource TextFaintBrush}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>

