<Window x:Class="WinNotch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.Views"
        xmlns:comp="clr-namespace:WinNotch.Views.Components"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        Title="WinNotch" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBackground" CornerRadius="{StaticResource InterfaceControlRadius}" Margin="0,0,2,0" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Header" Value="{x:Null}">
                                    <Setter TargetName="TabBackground" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="TabBackground" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fixed-size window; notch shape animates inside it. No window resizing. -->
    <Grid x:Name="RootGrid">
        <Canvas x:Name="NotchCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">

            <!-- Shadow layer (below the notch) -->
            <Path x:Name="ShadowPath"
                  Fill="{DynamicResource NotchShadowBrush}">
                <Path.Effect>
                    <BlurEffect Radius="12" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Liquid Glass: refracted + vibrancy-boosted backdrop; GPU blur on top.
                 The capture itself already bends content around the rim (edge lens). -->
            <Path x:Name="BackdropBlurPath" Opacity="0" IsHitTestVisible="False">
                <Path.Effect>
                    <BlurEffect Radius="9" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Main notch shape — in liquid glass the fill is a thin ~35% tint -->
            <Path x:Name="NotchPath"
                  Fill="{DynamicResource NotchFillBrush}"
                  Cursor="Hand"/>

            <!-- Liquid Glass: specular pass — bright top rim light falling off fast,
                 a faint mid sheen, and a soft counter-light along the bottom edge -->
            <Path x:Name="GlassSpecularPath" Opacity="0" IsHitTestVisible="False">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#55FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#1AFFFFFF" Offset="0.09"/>
                        <GradientStop Color="#06FFFFFF" Offset="0.28"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.90"/>
                        <GradientStop Color="#20FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Liquid Glass: glass ring — bright where light hits (top-left),
                 dimmer through the middle, softly lit again bottom-right -->
            <Path x:Name="GlassBorderPath" Opacity="0" IsHitTestVisible="False"
                  StrokeThickness="1.4" Fill="{x:Null}">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B4FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#3CFFFFFF" Offset="0.30"/>
                        <GradientStop Color="#1EFFFFFF" Offset="0.60"/>
                        <GradientStop Color="#78FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Liquid Glass: dark inner shadow for depth just inside the ring -->
            <Path x:Name="GlassInnerShadowPath" Opacity="0" IsHitTestVisible="False"
                  StrokeThickness="2.4" Fill="{x:Null}">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#20000000" Offset="0.55"/>
                        <GradientStop Color="#10000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Clip region for content (matches notch shape) -->
            <Grid x:Name="ContentGrid" ClipToBounds="True">
                <!-- Closed state content -->
                <Grid x:Name="ClosedContent" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Plugin closed content -->
                    <StackPanel x:Name="PluginClosedPanel" Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <views:MusicLiveActivity x:Name="LiveActivity"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Margin="6,0,2,0"/>
                    <views:ClockWidget x:Name="ClockWidget"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="8,0,2,0"
                                       Visibility="Visible"/>
                    <views:BatteryIndicator x:Name="BatteryIndicator"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>
                </Grid>

                <!-- Open state content -->
                <Grid x:Name="OpenContent" Opacity="0" Margin="12,6,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Main content (music + calendar) -->
                    <Grid x:Name="MainOpenContent" Grid.Row="0" SizeChanged="OnCardContentSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TabControl x:Name="CardTabs" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" SelectionChanged="OnCardSelectionChanged">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource InterfacePanelRadius}" Padding="4">
                                        <DockPanel LastChildFill="True">
                                            <Border x:Name="CardHeader" DockPanel.Dock="Top" Padding="0,0,0,2">
                                                <TabPanel IsItemsHost="True"/>
                                            </Border>
                                            <Border x:Name="CardBody" Background="Transparent" Padding="3,2,3,3" ClipToBounds="True">
                                                <ContentPresenter ContentSource="SelectedContent"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Tag" Value="ShelfDrop">
                                            <Setter TargetName="CardHeader" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabItem x:Name="MusicCardTab" Header="Media" Style="{StaticResource CardTab}">
                                <views:MusicPlayerView x:Name="MusicPlayer"/>
                            </TabItem>
                            <TabItem x:Name="CalendarCardTab" Header="Calendario" Style="{StaticResource CardTab}">
                                <StackPanel x:Name="CalendarPanel" Orientation="Horizontal">
                                    <views:CalendarView x:Name="CalendarPanel_View"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                        <!-- Plugin accessory content -->
                        <StackPanel x:Name="PluginAccessoryPanel" Grid.Column="2" Orientation="Horizontal"
                                    Visibility="Collapsed"/>

                        <!-- Webcam mirror -->
                        <StackPanel x:Name="WebcamPanel" Grid.Column="3" Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="8,4,8,4"/>
                            <views:WebcamView x:Name="WebcamMirror"/>
                        </StackPanel>
                        <!-- Settings open only from the tray icon. -->
                    </Grid>

                    <!-- File shelf (visible when files are shelved) -->

                    <!-- Plugin open content -->
                    <StackPanel x:Name="PluginOpenPanel" Grid.Row="2"
                                Margin="0,4,0,0"/>

                    <!-- Inline settings (hidden by default, shown when gear clicked) - slides down in top mode -->
                    <views:InlineSettingsView x:Name="InlineSettings"
                                              Grid.Row="3"
                                              MinHeight="320"
                                              Visibility="Collapsed"
                                              Margin="0,6,0,0"/>
                </Grid>

                <!-- Vertical closed content (side dock) -->
                <StackPanel x:Name="VerticalClosedContent" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel x:Name="VerticalPluginClosedPanel"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"/>
                    <TextBlock x:Name="SideTimeSmall" Text="12:00"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <!-- Vertical HUD Overlay for volume/brightness -->
                </StackPanel>

                <!-- Transient HUDs are independent of the closed/minimal content opacity. -->
                <views:HudOverlay x:Name="HudOverlay" VerticalAlignment="Center" Margin="6,0,6,0"/>
                <views:HudOverlay x:Name="VerticalHudOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Height="24">
                    <views:HudOverlay.LayoutTransform><RotateTransform Angle="90"/></views:HudOverlay.LayoutTransform>
                </views:HudOverlay>

                <!-- Vertical open content (side dock) - expands to the right when settings opened -->
                <Grid x:Name="VerticalOpenContent" Opacity="0" Visibility="Collapsed"
                      ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/> <!-- Main vertical panel - fixed width -->
                        <ColumnDefinition Width="Auto"/>    <!-- Settings panel (visibility-controlled) -->
                    </Grid.ColumnDefinitions>

                    <!-- Main vertical content -->
                    <StackPanel Grid.Column="0" Margin="4,8,4,8" Width="152">
                        <!-- Clock -->
                        <TextBlock x:Name="SideTimeText" Text="12:00"
                                   FontSize="28" FontWeight="Light"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SideDateText" Text="ven. 18"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,14"/>

                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="6,0,6,14"/>

                        <!-- Music -->
                        <StackPanel x:Name="SideMusicPanel" HorizontalAlignment="Center">
                            <Border Width="100" Height="100" CornerRadius="12"
                                    ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,8"
                                    Background="{DynamicResource SegmentedBgBrush}">
                                <Image x:Name="SideAlbumArt" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,100,100" RadiusX="18" RadiusY="18"/></Image.Clip></Image>
                            </Border>
                            <TextBlock x:Name="SideSongTitle" Text=""
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="130"/>
                            <TextBlock x:Name="SideArtistName" Text=""
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="130"
                                       Margin="0,2,0,6"/>

                            <!-- Progress bar -->
                            <Grid Margin="0,0,0,2" Width="130">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SideElapsedText" Grid.Column="0"
                                           Text="0:00" FontSize="9"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border Grid.Column="1" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource ProgressTrackBrush}"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnSideProgressBarClick">
                                    <Border x:Name="SideProgressFill" Height="3" CornerRadius="1.5"
                                            Background="{DynamicResource ProgressFillBrush}"
                                            HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock x:Name="SideDurationText" Grid.Column="2"
                                           Text="0:00" FontSize="9"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Audio visualizer -->
                            <comp:AudioVisualizer x:Name="SideVisualizer"
                                                  Width="80" Height="24"
                                                  BarCount="5" BarWidth="3" BarGap="2"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,4,0,6"/>

                            <!-- Play controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Click="OnSidePrevClick"
                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Click="OnSidePlayClick"
                                        Style="{StaticResource IconButton}" Width="32" Height="32"
                                        Margin="12,0">
                                    <TextBlock x:Name="SidePlayIcon" FontFamily="Segoe Fluent Icons" Text="&#xE768;" FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                                <Button Click="OnSideNextClick"
                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="VerticalPluginOpenPanel"
                                    Margin="0,14,0,0"/>

                        <!-- Bottom -->
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}"
                                Margin="6,14,6,10"/>
                    </StackPanel>

                    <!-- Settings panel for vertical mode (expands to the right) -->
                    <Border Grid.Column="1" x:Name="VerticalSettingsPanel"
                            Visibility="Collapsed"
                            Width="280"
                            ClipToBounds="True"
                            Background="{DynamicResource NotchFillBrush}"
                            Margin="0,8,0,8">
                        <views:InlineSettingsView x:Name="VerticalInlineSettings"
                                                  Width="264"
                                                  Margin="8,0,8,0"/>
                    </Border>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>





