<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Mismo nombre que el plugin original para reemplazarlo en personal.card.agent -->
    <AssemblyName>AgentCardPlugin</AssemblyName>
    <RootNamespace>PersonalCards</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinNotch.dll extraído del single-file WinNotch.exe (sfextract). No se copia a la salida. -->
    <Reference Include="WinNotch">
      <HintPath>..\ref\bundle\WinNotch.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
